# Required for the research agent. Without it dealscreen runs in data-only mode.
ANTHROPIC_API_KEY=sk-ant-placeholder-replace-me

# Optional
DEALSCREEN_MODEL=claude-sonnet-4-5
# Enable Anthropic's server-side web search tool (must be enabled for your API org).
DEALSCREEN_ANTHROPIC_WEB_SEARCH=false
# Free key from https://developer.company-information.service.gov.uk/ (recommended).
# Without it, dealscreen reads the public Companies House website, rate limited to 1 req/s.
COMPANIES_HOUSE_API_KEY=

DEALSCREEN_DATA_DIR=.dealscreen
DEALSCREEN_CACHE_TTL=86400
DEALSCREEN_HTTP_TIMEOUT=15
DEALSCREEN_MAX_TURNS=14
DEALSCREEN_BATCH_CONCURRENCY=2
# Only for sandboxes whose DNS returns fake-IP proxy addresses (e.g. 198.18.0.0/15).
DEALSCREEN_TRUSTED_EGRESS_CIDRS=
